<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds: system CAs plus the ones the person installed on the
     device, so a development server with a private certificate works. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
