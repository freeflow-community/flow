{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @flow/shared build && pnpm --filter @flow/slack-connector build",
    "watchPatterns": ["packages/slack-connector/**", "packages/shared/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "node packages/slack-connector/src/index.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
